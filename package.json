{
  "name": "llm-parallel-per-path",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Run LLM prompts in parallel, grouped by file path from any command output.",
  "scripts": {
    "typecheck": "pnpm -r --no-bail run typecheck",
    "format": "pnpm -r --no-bail run format",
    "lint": "pnpm -r --no-bail run lint",
    "lint:fix": "pnpm -r --no-bail run lint:fix",
    "build": "pnpm -r --no-bail run build",
    "test": "pnpm -r --no-bail run test",
    "check:all": "pnpm -r --no-bail run check:all"
  },
  "author": "baseballyama",
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.10.1",
    "@typescript/native-preview": "7.0.0-dev.20251202.1",
    "oxfmt": "^0.16.0",
    "oxlint": "^1.31.0",
    "rolldown": "1.1.1",
    "vitest": "^4.0.14"
  }
}
