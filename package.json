{
  "name": "llm-parallel-per-path",
  "version": "0.1.0",
  "type": "module",
  "description": "Run LLM prompts in parallel, grouped by file path from any command output.",
  "bin": {
    "claudeppp": "dist/claudeppp.js",
    "geminippp": "dist/geminippp.js",
    "codexppp": "dist/codexppp.js",
    "chunker": "dist/chunker.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "format": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "build": "rolldown -c rolldown.config.ts",
    "test": "vitest run",
    "check:all": "pnpm run typecheck && pnpm run format && pnpm run lint && pnpm run build && pnpm run test"
  },
  "keywords": [
    "llm",
    "parallel",
    "per-path",
    "command",
    "output",
    "grouped",
    "file",
    "path"
  ],
  "author": "baseballyama",
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.10.1",
    "@typescript/native-preview": "7.0.0-dev.20251202.1",
    "oxfmt": "^0.16.0",
    "oxlint": "^1.31.0",
    "rolldown": "1.0.0-beta.52",
    "vitest": "^4.0.14"
  }
}
