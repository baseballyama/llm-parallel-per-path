{
  "name": "codex-ppp",
  "version": "0.2.2",
  "type": "module",
  "description": "Run Codex prompts in parallel, grouped by file path from any command output.",
  "bin": {
    "codex-ppp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "format": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "build": "rolldown -c rolldown.config.ts",
    "test": "vitest run --pass-with-no-tests",
    "check:all": "pnpm run typecheck && pnpm run format && pnpm run lint && pnpm run build && pnpm run test"
  },
  "keywords": [
    "codex",
    "openai",
    "llm",
    "parallel",
    "cli"
  ],
  "author": "baseballyama",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/baseballyama/llm-parallel-per-path",
    "directory": "packages/codex-ppp"
  },
  "devDependencies": {
    "@llm-ppp/shared": "workspace:*",
    "rolldown": "1.0.0-beta.52"
  }
}
